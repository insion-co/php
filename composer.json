{
  "name": "insion/insion",
  "description": "Official PHP client for the Insion API",
  "type": "library",
  "keywords": [
    "insion",
    "api",
    "sdk",
    "moderation",
    "content-moderation"
  ],
  "homepage": "https://insion.co/docs/sdks/php",
  "license": "MIT",
  "authors": [
    {
      "name": "Insion",
      "email": "support@insion.co",
      "homepage": "https://insion.co"
    }
  ],
  "support": {
    "email": "support@insion.co",
    "issues": "https://github.com/insion-co/php/issues",
    "source": "https://github.com/insion-co/php",
    "docs": "https://insion.co/docs/sdks/php"
  },
  "require": {
    "php": "^8.1",
    "ext-json": "*",
    "psr/http-client": "^1.0",
    "psr/http-client-implementation": "^1.0",
    "psr/http-factory": "^1.0",
    "psr/http-factory-implementation": "^1.0",
    "psr/http-message": "^1.1 || ^2.0",
    "php-http/discovery": "^1.0",
    "php-http/multipart-stream-builder": "^1.0",
    "guzzlehttp/guzzle": "^7.4"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5 || ^11.5 || ^12.0",
    "friendsofphp/php-cs-fixer": "^3.64",
    "phpstan/phpstan": "^2.2"
  },
  "autoload": {
    "psr-4": {
      "Insion\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Insion\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "build": "@lint",
    "lint": "find src tests -type f -name '*.php' -print0 | xargs -0 -n1 php -l",
    "test": "phpunit",
    "analyze": "phpstan analyze src tests --memory-limit=1G",
    "check": [
      "@composer validate --strict --no-check-lock",
      "@lint",
      "@analyze",
      "@test"
    ]
  }
}
